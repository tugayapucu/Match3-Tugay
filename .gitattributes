# Auto detect text files and perform LF normalization
* text=auto

*.cs text eol=lf
*.shader text eol=lf
*.cginc text eol=lf
*.hlsl text eol=lf
*.compute text eol=lf
*.json text eol=lf
*.asmdef text eol=lf
*.asmref text eol=lf
*.uxml text eol=lf
*.uss text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.meta text eol=lf
*.inputactions text eol=lf
*.scenetemplate text eol=lf